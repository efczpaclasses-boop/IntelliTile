<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en-GB</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>intellitile</string>
			</array>
		</dict>
	</array>
	<key>CFBundleIconName</key>
	<string>$(ASSETCATALOG_COMPILER_APPICON_NAME)</string>
	<key>DTEnvironment</key>
	<string>$(DOCKTILE_ENVIRONMENT)</string>
	<key>DTHelperPrefix</key>
	<string>$(DOCKTILE_HELPER_PREFIX)</string>
	<key>DTPrefsFilename</key>
	<string>$(DOCKTILE_PREFS_FILENAME)</string>
	<key>DTSupportFolder</key>
	<string>$(DOCKTILE_SUPPORT_FOLDER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSUIElement</key>
	<false/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 k97 and contributors. MIT licence.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Firebase is configured manually in main.swift (AppKit, no UIApplication).
	     Disable delegate swizzling to avoid surprises. -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<!-- IntelliTile (Intel Mac port): Firebase stays linked but is switched off. No
	     GoogleService-Info.plist ships, so FirebaseApp.configure() is never called; these
	     kill switches keep collection off even if one is added later. -->
	<key>FIREBASE_ANALYTICS_COLLECTION_DEACTIVATED</key>
	<true/>
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<false/>
</dict>
</plist>
