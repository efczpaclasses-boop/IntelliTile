// Release.xcconfig
// Production build configuration for "IntelliTile" (Intel Mac port of k97/dock-tile)
// See RELEASE.md for documentation on Dev/Release workflow

#include "Base.xcconfig"

// App Identity
PRODUCT_BUNDLE_IDENTIFIER = io.github.efczpaclasses-boop.IntelliTile
PRODUCT_NAME = IntelliTile

// Icon
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Environment-specific values (read at runtime via Info.plist)
DOCKTILE_ENVIRONMENT = RELEASE
DOCKTILE_HELPER_PREFIX = io.github.efczpaclasses-boop.IntelliTile.tile
DOCKTILE_PREFS_FILENAME = io.github.efczpaclasses-boop.IntelliTile.configs.json
DOCKTILE_SUPPORT_FOLDER = IntelliTile

// Ship only this build's start-at-login launcher plist (the Copy Files phase lists both).
// Guarded by LoginLauncherBundleTests (configExcludesOtherPlist reads this line).
EXCLUDED_SOURCE_FILE_NAMES = io.github.efczpaclasses-boop.IntelliTile.dev.tilelauncher.plist
