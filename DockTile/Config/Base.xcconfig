// Base.xcconfig
// Shared build settings for all DockTile variants
// See RELEASE.md for documentation on Dev/Release workflow

// Version
MARKETING_VERSION = 2.8.1
CURRENT_PROJECT_VERSION = 50

// IntelliTile: fork release tag stamped into Info.plist (ITReleaseTag). Empty here; the release
// workflow passes INTELLITILE_RELEASE_TAG=vX.Y.Z-intel.N on the xcodebuild command line.
INTELLITILE_RELEASE_TAG =

// Deployment
MACOSX_DEPLOYMENT_TARGET = 15.0

// Swift
SWIFT_VERSION = 6.0

// Module name - keep consistent across Debug/Release for testability
// The PRODUCT_NAME can differ (IntelliTile Dev vs IntelliTile) but module name must be stable
PRODUCT_MODULE_NAME = Dock_Tile
