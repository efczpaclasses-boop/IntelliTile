// Dev.xcconfig
// Development build configuration for "IntelliTile Dev"
// See RELEASE.md for documentation on Dev/Release workflow

#include "Base.xcconfig"

// App Identity
PRODUCT_BUNDLE_IDENTIFIER = io.github.efczpaclasses-boop.IntelliTile.dev
PRODUCT_NAME = IntelliTile Dev

// Icon (requires AppIcon-Dev.icon in Resources)
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Dev

// Environment-specific values (read at runtime via Info.plist)
DOCKTILE_ENVIRONMENT = DEV
DOCKTILE_HELPER_PREFIX = io.github.efczpaclasses-boop.IntelliTile.dev.tile
DOCKTILE_PREFS_FILENAME = io.github.efczpaclasses-boop.IntelliTile.dev.configs.json
DOCKTILE_SUPPORT_FOLDER = IntelliTile-Dev

// Ship only this build's start-at-login launcher plist (the Copy Files phase lists both).
// Guarded by LoginLauncherBundleTests.
EXCLUDED_SOURCE_FILE_NAMES = io.github.efczpaclasses-boop.IntelliTile.tilelauncher.plist
